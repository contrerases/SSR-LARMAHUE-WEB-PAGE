# Copia este archivo como `.env` y completa los valores.
# Solo las variables con prefijo PUBLIC_ quedan disponibles en el navegador.

# URL del Web App de Google Apps Script (contenido dinámico desde Sheets + Drive).
# Ej: https://script.google.com/macros/s/AKfycb.../exec
PUBLIC_CONTENT_API=

# Clave de acceso de Web3Forms para el formulario de contacto (https://web3forms.com).
# Clave PÚBLICA: solo enruta los envíos al correo asociado. Ej: 00000000-0000-0000-0000-000000000000
PUBLIC_WEB3FORMS_KEY=
