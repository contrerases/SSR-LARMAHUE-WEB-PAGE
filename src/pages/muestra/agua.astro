---
// Diseño B · El Agua nos Mueve — fluido, asimétrico, glass, ondas superpuestas.
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/hanken-grotesk";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Button, Badge, ContactItem, WhatsappButton, ThemeToggle } from "../../components/ui";
import { site, navLinks } from "../../config/site";

const servicios = [
  { t: "Galería", d: "Obras y actividades." },
  { t: "Videos", d: "Material audiovisual." },
  { t: "Biblioteca", d: "Documentos y estatutos." },
  { t: "Conozca su Boleta", d: "Entiende tu boleta." },
];
---
<BaseLayout design="agua" title="Diseño · El Agua nos Mueve">
  <!-- Header flotante tipo píldora -->
  <header class="fixed inset-x-0 top-4 z-50 px-4">
    <div class="mx-auto flex max-w-5xl items-center justify-between gap-3 rounded-full border border-white/20 bg-white/10 px-4 py-2.5 shadow-lg backdrop-blur-xl dark:bg-white/5">
      <a href="#" class="flex items-center gap-2 pl-1 text-white">
        <span class="flex size-8 items-center justify-center rounded-full bg-white/20"><svg viewBox="0 0 24 24" fill="currentColor" class="size-4"><path d="M12 3s6 6.5 6 10a6 6 0 1 1-12 0c0-3.5 6-10 6-10Z"/></svg></span>
        <span class="font-display text-sm font-bold">{site.name}</span>
      </a>
      <nav class="hidden items-center gap-1 md:flex">
        {navLinks.map((l) => <a href={l.href} class="rounded-full px-3 py-1.5 text-sm font-medium text-white/80 hover:bg-white/15 hover:text-white">{l.label}</a>)}
      </nav>
      <Button href={site.services.pagoEnLinea} variant="pago" size="sm" external>Pagar</Button>
    </div>
  </header>

  <!-- Hero a sangre, asimétrico, con tarjeta glass superpuesta -->
  <section class="relative isolate overflow-hidden pt-28 text-white" style="background-image: var(--hero-gradient)">
    <!-- burbujas -->
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <span class="bubble absolute left-[8%] top-[30%] size-24 rounded-full bg-white/10"></span>
      <span class="bubble absolute right-[14%] top-[18%] size-40 rounded-full bg-white/10" style="animation-delay:-3s"></span>
      <span class="bubble absolute left-[40%] bottom-[20%] size-16 rounded-full bg-white/10" style="animation-delay:-6s"></span>
    </div>

    <div class="mx-auto grid max-w-6xl gap-10 px-5 pb-40 pt-10 sm:px-8 lg:grid-cols-12 lg:pb-52">
      <div class="flex flex-col gap-6 lg:col-span-7">
        <span class="w-fit rounded-full bg-white/15 px-4 py-1.5 text-sm font-semibold uppercase tracking-[0.16em] backdrop-blur">{site.slogan}</span>
        <h1 class="text-balance font-display text-5xl font-extrabold leading-[0.98] sm:text-6xl lg:text-7xl">
          El agua<br />nos mueve
        </h1>
        <p class="max-w-md text-lg text-white/85">{site.mission}</p>
      </div>
      <!-- Tarjeta glass flotante -->
      <div class="lg:col-span-5 lg:mt-8">
        <div class="rounded-[2rem] border border-white/25 bg-white/15 p-6 shadow-2xl backdrop-blur-2xl">
          <p class="mb-4 text-sm font-semibold uppercase tracking-wide text-white/70">Accesos</p>
          <div class="flex flex-col gap-3">
            <Button href={site.services.oficinaVirtual} variant="ov" size="lg" external class="w-full">Oficina Virtual</Button>
            <Button href={site.services.pagoEnLinea} variant="pago" size="lg" external class="w-full">Pagar mi Boleta</Button>
          </div>
          <div class="mt-5 flex items-center justify-between rounded-full bg-white/10 px-4 py-3 text-sm">
            <span class="text-white/70">Emergencias</span>
            <a href={`tel:${site.contact.emergencyPhone.replace(/\s/g,"")}`} class="font-bold">{site.contact.emergencyPhone}</a>
          </div>
        </div>
      </div>
    </div>

    <!-- ondas superpuestas al fondo -->
    <div class="absolute inset-x-0 bottom-0 leading-[0]" aria-hidden="true">
      <svg viewBox="0 0 1440 140" preserveAspectRatio="none" class="h-[80px] w-full sm:h-[120px]" style="color: var(--background)">
        <path fill="currentColor" opacity="0.5" d="M0 60 C240 120 480 20 720 60 C960 100 1200 30 1440 70 L1440 140 L0 140 Z"/>
        <path fill="currentColor" d="M0 90 C240 140 480 50 720 90 C960 120 1200 60 1440 100 L1440 140 L0 140 Z"/>
      </svg>
    </div>
  </section>

  <!-- Servicios escalonados (offset) -->
  <section class="py-20">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <h2 class="mb-14 max-w-xl font-display text-4xl font-extrabold">Todo fluye desde aquí</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {servicios.map((s, i) => (
          <article class={`flex flex-col rounded-[1.75rem] border border-border bg-card p-6 text-card-foreground shadow-card backdrop-blur-sm transition-transform hover:-translate-y-2 ${i % 2 === 1 ? "lg:mt-12" : ""}`}>
            <span class="mb-4 flex size-14 items-center justify-center rounded-full bg-primary/15 text-primary">
              <svg viewBox="0 0 24 24" fill="currentColor" class="size-7"><path d="M12 3s6 6.5 6 10a6 6 0 1 1-12 0c0-3.5 6-10 6-10Z"/></svg>
            </span>
            <h3 class="font-display text-lg font-bold">{s.t}</h3>
            <p class="mt-1.5 flex-1 text-sm text-muted-foreground">{s.d}</p>
            <span class="mt-4 inline-flex w-fit items-center gap-1 rounded-full bg-muted px-4 py-2 text-sm font-semibold text-primary">Ver más →</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Banda de flujo con blob -->
  <section class="relative overflow-hidden py-20 text-white" style="background-image: var(--hero-gradient)">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 sm:px-8 lg:grid-cols-2">
      <div class="rounded-[2.5rem] bg-white/10 p-8 backdrop-blur-xl lg:justify-self-start">
        <p class="text-sm font-semibold uppercase tracking-wide text-white/70">Nuestro compromiso</p>
        <p class="mt-3 font-display text-2xl font-bold leading-snug">Integrar el consumo responsable del agua con el respeto al medioambiente y a las personas.</p>
      </div>
      <div class="flex items-center justify-between gap-4 rounded-full bg-white/15 px-6 py-5 backdrop-blur-xl">
        <div>
          <p class="font-bold">¿Fuga o desperfecto?</p>
          <p class="text-sm text-white/75">Fono {site.contact.officePhone}</p>
        </div>
        <Button href={`tel:${site.contact.officePhone}`} variant="ov">Avisar</Button>
      </div>
    </div>
  </section>

  <!-- Contacto -->
  <section id="contacto" class="py-20">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 sm:px-8 lg:grid-cols-2">
      <div>
        <Badge tone="ov" class="mb-3">Contacto</Badge>
        <h2 class="font-display text-4xl font-extrabold">Hablemos</h2>
        <p class="mt-3 max-w-md text-muted-foreground">Oficina o WhatsApp para emergencias.</p>
      </div>
      <div class="grid gap-5 rounded-[2rem] border border-border bg-card p-8 shadow-card backdrop-blur-sm sm:grid-cols-2">
        <ContactItem icon="pin" label="Dirección" value={site.location} />
        <ContactItem icon="mail" label="Correo" value={site.contact.email} href={`mailto:${site.contact.email}`} />
        <ContactItem icon="phone" label="Fono oficina" value={site.contact.officePhone} href={`tel:${site.contact.officePhone}`} />
        <ContactItem icon="emergency" label="Emergencias" value={site.contact.emergencyPhone} />
      </div>
    </div>
  </section>

  <!-- Footer con onda -->
  <footer class="relative mt-10 text-white" style="background-image: var(--hero-gradient)">
    <div class="absolute inset-x-0 top-0 -translate-y-full leading-[0]" aria-hidden="true">
      <svg viewBox="0 0 1440 120" preserveAspectRatio="none" class="h-[70px] w-full" style="color: var(--primary)"><path fill="currentColor" d="M0 60 C360 0 1080 120 1440 60 L1440 120 L0 120 Z"/></svg>
    </div>
    <div class="mx-auto flex max-w-6xl flex-col items-center gap-2 px-5 py-12 text-center">
      <span class="font-display text-xl font-bold">{site.name}</span>
      <span class="text-sm text-white/70">© 2026 {site.fullName}</span>
      <div class="mt-2"><ThemeToggle /></div>
    </div>
  </footer>

  <WhatsappButton phone={site.contact.emergencyPhone} />

  <style>
    @keyframes floaty { 0%,100% { transform: translateY(0) } 50% { transform: translateY(-22px) } }
    .bubble { animation: floaty 9s ease-in-out infinite; }
    @media (prefers-reduced-motion: reduce) { .bubble { animation: none } }
  </style>
</BaseLayout>
