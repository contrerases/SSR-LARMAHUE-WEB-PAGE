---
// Diseño C · Territorio y Agua — editorial tipo revista, serif, líneas divisorias.
import "@fontsource-variable/fraunces";
import "@fontsource-variable/hanken-grotesk";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Button, ContactItem, WhatsappButton, ThemeToggle } from "../../components/ui";
import { site, navLinks } from "../../config/site";

const servicios = [
  { n: "01", t: "Galería", d: "Imágenes de obras y actividades del servicio." },
  { n: "02", t: "Videos", d: "Material audiovisual de la comunidad." },
  { n: "03", t: "Biblioteca", d: "Reglamentos, estatutos y documentos oficiales." },
  { n: "04", t: "Conozca su Boleta", d: "Aprenda a leer y entender su boleta." },
];
---
<BaseLayout design="territorio" title="Diseño · Territorio y Agua">
  <!-- Header editorial minimal -->
  <header class="border-b border-foreground/15">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-5 sm:px-8">
      <a href="#" class="font-display text-xl font-semibold tracking-tight">{site.name}</a>
      <nav class="hidden items-center gap-6 md:flex">
        {navLinks.map((l) => <a href={l.href} class="text-sm font-medium uppercase tracking-wide text-muted-foreground hover:text-primary">{l.label}</a>)}
      </nav>
      <div class="flex items-center gap-2">
        <Button href={site.services.pagoEnLinea} variant="pago" size="sm" external>Pagar</Button>
        <ThemeToggle />
      </div>
    </div>
  </header>

  <!-- Hero editorial: titular serif enorme + intro a dos columnas -->
  <section class="border-b border-foreground/15">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 lg:py-24">
      <p class="flex items-center gap-3 text-sm font-medium uppercase tracking-[0.2em] text-primary">
        <span class="h-px w-10 bg-primary"></span>{site.slogan}
      </p>
      <h1 class="mt-6 max-w-4xl text-balance font-display text-5xl font-semibold leading-[1.02] tracking-tight sm:text-6xl lg:text-7xl">
        El agua que une a <em class="italic text-primary">Larmahue</em>
      </h1>
      <div class="mt-10 grid gap-8 border-t border-foreground/15 pt-8 lg:grid-cols-12">
        <p class="text-sm font-semibold uppercase tracking-wide text-muted-foreground lg:col-span-4">
          Servicio Sanitario Rural · Pichidegua
        </p>
        <div class="lg:col-span-8">
          <p class="max-w-2xl text-lg leading-relaxed text-foreground/80">{site.mission}</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <Button href={site.services.pagoEnLinea} variant="pago" size="lg" external>Pagar mi boleta</Button>
            <Button href={site.services.oficinaVirtual} variant="ov" size="lg" external>Oficina Virtual</Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Servicios: lista numerada con líneas divisorias -->
  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
    <div class="grid gap-8 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <h2 class="font-display text-3xl font-semibold">Información<br />y trámites</h2>
        <p class="mt-3 max-w-xs text-muted-foreground">Todo lo que necesitas, en un solo lugar.</p>
      </div>
      <ul class="lg:col-span-8">
        {servicios.map((s) => (
          <li>
            <a href="#" class="group grid grid-cols-[auto_1fr_auto] items-center gap-5 border-t border-foreground/15 py-6 last:border-b">
              <span class="font-display text-2xl font-semibold text-muted-foreground">{s.n}</span>
              <span>
                <span class="block font-display text-xl font-semibold group-hover:text-primary">{s.t}</span>
                <span class="mt-0.5 block text-sm text-muted-foreground">{s.d}</span>
              </span>
              <span class="text-xl text-primary transition-transform group-hover:translate-x-1">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Cita / compromiso editorial -->
  <section class="border-y border-foreground/15 bg-secondary/40">
    <div class="mx-auto max-w-4xl px-5 py-20 text-center sm:px-8">
      <p class="font-display text-2xl font-medium italic leading-relaxed sm:text-3xl">
        “Integrar el consumo responsable del agua con comportamientos respetuosos hacia el medioambiente y a las personas.”
      </p>
    </div>
  </section>

  <!-- Aviso con regla lateral -->
  <section class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
    <div class="flex flex-col gap-4 border-l-4 border-accent pl-6 sm:flex-row sm:items-center">
      <p class="flex-1 text-lg"><strong class="font-display">¿Fuga o desperfecto?</strong> Infórmanos al fono {site.contact.officePhone} y pasaremos a revisar.</p>
      <Button href={`tel:${site.contact.officePhone}`} variant="primary">Llamar</Button>
    </div>
  </section>

  <!-- Contacto editorial en columnas con reglas -->
  <section id="contacto" class="border-t border-foreground/15">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 sm:px-8 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <h2 class="font-display text-3xl font-semibold">Contacto</h2>
        <p class="mt-3 max-w-xs text-muted-foreground">Oficina o WhatsApp en caso de emergencia.</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:col-span-8">
        <ContactItem icon="pin" label="Dirección" value={site.location} />
        <ContactItem icon="mail" label="Correo" value={site.contact.email} href={`mailto:${site.contact.email}`} />
        <ContactItem icon="phone" label="Fono oficina" value={site.contact.officePhone} href={`tel:${site.contact.officePhone}`} />
        <ContactItem icon="emergency" label="Emergencias" value={site.contact.emergencyPhone} />
      </div>
    </div>
  </section>

  <!-- Footer editorial -->
  <footer class="border-t border-foreground/15">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 px-5 py-8 text-sm text-muted-foreground sm:flex-row sm:px-8">
      <span class="font-display text-base font-semibold text-foreground">{site.fullName}</span>
      <span>© 2026 · Pichidegua, Chile</span>
      <a href="#" class="hover:text-primary">Políticas de Privacidad</a>
    </div>
  </footer>

  <WhatsappButton phone={site.contact.emergencyPhone} />
</BaseLayout>
