---
/**
 * Página de inicio · SSR Larmahue (diseño "El Agua nos Mueve").
 * Composición de secciones. Todo el texto proviene de @/data y las imágenes
 * de @/assets/images (optimizadas por astro:assets).
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  SiteHeader,
  Hero,
  ServicesGrid,
  About,
  MissionVision,
  Gallery,
  Commitment,
  ContactSection,
  SiteFooter,
} from "@/components/sections";
import { WhatsappButton } from "@/components/ui";
import { content } from "@/data";
---
<BaseLayout
  title="Agua potable rural en Pichidegua"
  description="Servicio Sanitario Rural Larmahue (Pichidegua, O'Higgins): paga tu boleta en línea, accede a la Oficina Virtual y reporta emergencias de agua potable."
>
  <SiteHeader />
  <main id="contenido">
    <Hero />
    <ServicesGrid />
    <About />
    <MissionVision />
    <Gallery />
    <Commitment />
    <ContactSection />
  </main>
  <SiteFooter />
  <WhatsappButton
    phone={content.site.contact.emergencyPhone}
    message={content.copy.whatsapp.defaultMessage}
  />
</BaseLayout>
