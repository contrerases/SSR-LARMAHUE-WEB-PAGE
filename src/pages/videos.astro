---
import PageLayout from "@/layouts/PageLayout.astro";
import PageHero from "@/components/sections/PageHero.astro";
import VideoCard from "@/components/pages/VideoCard.astro";
import { content } from "@/data";
---
<PageLayout
  title="Videos"
  description="Material audiovisual del Servicio Sanitario Rural Larmahue."
>
  <PageHero
    eyebrow="Multimedia"
    title="Videos"
    subtitle="Material audiovisual del servicio y de la comunidad."
  />

  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <p class="mb-8 text-sm text-muted-foreground">
        Videos de muestra — se reemplazarán por el material audiovisual real del comité.
      </p>
      <div class="grid gap-6 sm:grid-cols-2">
        {
          content.videos.map((v) => (
            <VideoCard title={v.title} description={v.description} src={v.src} poster={v.poster} />
          ))
        }
      </div>
    </div>
  </section>
</PageLayout>
