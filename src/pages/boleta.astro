---
import PageLayout from "@/layouts/PageLayout.astro";
import PageHero from "@/components/sections/PageHero.astro";
import BillReceipt from "@/components/pages/BillReceipt.astro";
import { Button } from "@/components/ui";
import { content } from "@/data";

const { bill, site } = content;
---
<PageLayout
  title="Conozca su Boleta"
  description="Aprende a leer y entender tu boleta del Servicio Sanitario Rural Larmahue: cada parte explicada."
>
  <PageHero eyebrow="Ayuda" title="Conozca su Boleta" subtitle={bill.intro} />

  <!-- Boleta recreada (interactiva) -->
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-5xl px-5 sm:px-8">
      <p class="mb-8 text-center text-sm text-muted-foreground">
        Pasa el cursor sobre una sección de la boleta —o sobre su explicación— para resaltarlas.
      </p>
      <BillReceipt />
    </div>
  </section>

  <!-- Explicación de cada parte (sincronizada con la boleta) -->
  <section class="bg-muted/40 py-16 sm:py-20">
    <div class="mx-auto max-w-5xl px-5 sm:px-8">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-primary">Partes de la boleta</p>
        <h2 class="mt-3 font-display text-3xl font-bold sm:text-4xl">Qué significa cada sección</h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {
          bill.parts.map((part, i) => (
            <article
              data-part={String(i + 1)}
              class="relative rounded-[1.25rem] border border-border bg-card p-6 pl-16 shadow-card transition data-[active=true]:border-primary data-[active=true]:ring-2 data-[active=true]:ring-primary/50"
            >
              <span class="absolute left-5 top-6 grid size-9 place-items-center rounded-full bg-primary text-sm font-bold text-primary-foreground">
                {i + 1}
              </span>
              <h3 class="font-display text-lg font-bold text-foreground">{part.title}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{part.description}</p>
            </article>
          ))
        }
      </div>

      <div class="mt-12 flex flex-col items-center gap-4 text-center">
        <p class="text-muted-foreground">¿Quieres revisar o pagar tu boleta?</p>
        <div class="flex flex-wrap justify-center gap-3">
          <Button href={site.services.pagoEnLinea} variant="pago" size="lg">Pagar en Línea</Button>
          <Button href={site.services.oficinaVirtual} variant="ov" size="lg">Oficina Virtual</Button>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<script>
  // Resalta en sincronía la sección de la boleta y su explicación (mismo data-part).
  const setActive = (n: string, on: boolean) =>
    document.querySelectorAll(`[data-part="${n}"]`).forEach((el) => {
      if (on) el.setAttribute("data-active", "true");
      else el.removeAttribute("data-active");
    });

  document.querySelectorAll<HTMLElement>("[data-part]").forEach((el) => {
    const n = el.dataset.part;
    if (!n) return;
    el.addEventListener("mouseenter", () => setActive(n, true));
    el.addEventListener("mouseleave", () => setActive(n, false));
  });
</script>
