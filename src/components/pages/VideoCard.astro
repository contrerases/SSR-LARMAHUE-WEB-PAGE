---
/** Tarjeta de video: reproductor nativo con póster (carga diferida). */
interface Props {
  title: string;
  description: string;
  src: string;
  poster: string;
}
const { title, description, src, poster } = Astro.props;
---
<figure class="flex flex-col overflow-hidden rounded-[1.5rem] border border-border bg-card shadow-card">
  <video
    controls
    preload="none"
    poster={poster}
    class="aspect-video w-full bg-muted object-cover"
  >
    <source src={src} type="video/mp4" />
    Tu navegador no soporta la reproducción de video.
  </video>
  <figcaption class="p-5">
    <h3 class="font-display font-bold text-foreground">{title}</h3>
    <p class="mt-1 text-sm text-muted-foreground">{description}</p>
  </figcaption>
</figure>
