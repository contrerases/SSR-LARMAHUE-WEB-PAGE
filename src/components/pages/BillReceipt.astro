---
/**
 * Recreación en HTML de la boleta de ejemplo del SSR Larmahue (reemplaza la
 * imagen original). Cada sección es un enlace a su explicación (#id) y se
 * resalta en sincronía (data-part) al pasar el cursor.
 */
import { Icon } from "@/components/ui";

const cliente = [
  ["Razón Social", "JOSÉ GONZÁLEZ ROJAS"],
  ["R.U.T.", "11.111.111-1"],
  ["Dirección", "VILLA LOS NOGALES N°10000"],
  ["Comuna", "PICHIDEGUA"],
  ["Giro", ""],
  ["Fec. Emisión", "31-05-2024"],
];
const suministro = [
  ["Sector", "LA HIGUERITA"],
  ["Ruta", "20"],
  ["Direc. Med.", "LA HIGUERITA 1"],
  ["N° Medidor", ""],
  ["Diámetro", "13"],
  ["N° Contrato", "20"],
  ["N° Servicio", ""],
  ["Tarifa", "TARIFA DE MEDIA"],
];
const consumo = [
  ["Lectura Actual", "24-05-2024   811 m3"],
  ["Lectura Anterior", "25-04-2024   810 m3"],
  ["Sub Total Consumo", "1 m3"],
  ["Total Consumo", "1 m3"],
  ["* Consumo (M3)", "1"],
];
const cuentaItems = [
  ["CARGO FIJO AGUA POTABLE", "$ 2.500"],
  ["CONSUMO AGUA POTABLE", "$ 500"],
];
const cuentaTotales = [
  ["TOTAL EXENTO", "$ 3.000"],
  ["TOTAL FACTURABLE", "$ 3.000"],
  ["TOTAL NO FACTURABLE", "$ 0"],
  ["TOTAL PERIODO", "$ 3.000"],
];
const chart = [5, 4, 3, 4, 5, 4, 6, 5, 8, 9, 7, 6, 4];
const meses = ["May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic", "Ene", "Feb", "Mar", "Abr", "May"];

const link =
  "relative block cursor-pointer rounded border border-slate-300 bg-white transition duration-200 hover:z-10 hover:scale-[1.03] hover:border-primary hover:shadow-xl focus-visible:outline-2 focus-visible:outline-primary data-[active=true]:z-10 data-[active=true]:border-primary data-[active=true]:ring-2 data-[active=true]:ring-primary/60";
const badge =
  "absolute -left-2.5 -top-2.5 z-20 grid size-6 place-items-center rounded-full bg-primary text-[11px] font-bold text-primary-foreground shadow ring-2 ring-white";
const cap =
  "border-b border-slate-200 bg-slate-50 px-2 py-1 font-sans text-[10px] font-bold uppercase tracking-wide text-slate-700";
const kv = "grid grid-cols-[6.5rem_1fr] gap-x-1 gap-y-0.5";
---
<div class="mx-auto max-w-3xl rounded-[1.25rem] border border-border bg-white p-3 text-slate-900 shadow-card sm:p-5">
  <!-- Cabecera -->
  <div class="flex flex-wrap items-start justify-between gap-3 pb-3">
    <div class="flex items-start gap-2">
      <span class="grid size-10 shrink-0 place-items-center rounded-full bg-primary/10 text-primary">
        <Icon name="drop" size="1.5rem" />
      </span>
      <div class="text-[10px] leading-tight sm:text-[11px]">
        <p class="font-display text-xs font-bold text-primary sm:text-sm">COMITÉ DE AGUA POTABLE RURAL LARMAHUE</p>
        <p class="font-semibold text-slate-700">CAPTACIÓN, TRATAMIENTO Y DISTRIBUCIÓN DE AGUA</p>
        <p class="mt-1"><b>DIRECCIÓN:</b> Larmahue s/n, Pichidegua</p>
        <p><b>FONO:</b> 9-92261976</p>
        <p><b>CORREO ELECTRÓNICO:</b> comitelarmahue@gmail.com</p>
      </div>
    </div>
    <div class="text-center text-[10px] sm:text-[11px]">
      <div class="rounded-md border-2 border-red-600 px-4 py-2 leading-tight">
        <p class="font-bold">R.U.T.: 71.272.000-K</p>
        <p class="my-1 font-bold">BOLETA EXENTA<br />ELECTRÓNICA</p>
        <p class="font-bold">N° 50413</p>
      </div>
      <p class="mt-1 font-semibold text-slate-600">S.I.I. - SAN VICENTE T.T.</p>
    </div>
  </div>

  <!-- Fila: Datos del Cliente | Número Contrato -->
  <div class="grid gap-2 font-mono text-[10px] leading-relaxed sm:grid-cols-[1.7fr_1fr] sm:text-[11px]">
    <a href="#datos-cliente" data-part="datos-cliente" class={link} aria-label="Ver explicación: Datos del Cliente">
      <span class={badge}>1</span>
      <p class={cap}>Datos del Cliente</p>
      <div class={`${kv} p-2`}>
        {cliente.map(([k, v]) => (<><span class="text-slate-500">{k}</span><span class="font-semibold">: {v}</span></>))}
      </div>
    </a>
    <a href="#numero-contrato" data-part="numero-contrato" class={link} aria-label="Ver explicación: Número de Contrato">
      <span class={badge}>2</span>
      <p class={cap}>Número Contrato</p>
      <div class="flex items-center gap-3 p-2">
        <span class="font-display text-2xl font-extrabold">20</span>
        <span class="h-9 flex-1 rounded-sm" style="background: repeating-linear-gradient(90deg,#111 0 2px,transparent 2px 3px,#111 3px 6px,transparent 6px 8px,#111 8px 9px,transparent 9px 12px,#111 12px 14px,transparent 14px 18px)"></span>
      </div>
    </a>
  </div>

  <!-- Fila: Detalle de su Cuenta | (Suministro + Consumo) -->
  <div class="mt-2 grid gap-2 font-mono text-[10px] leading-relaxed sm:grid-cols-[1.7fr_1fr] sm:text-[11px]">
    <a href="#detalle-cuenta" data-part="detalle-cuenta" class={link} aria-label="Ver explicación: Detalle de su Cuenta">
      <span class={badge}>5</span>
      <p class={cap}>Detalle de su Cuenta</p>
      <div class="p-2">
        {cuentaItems.map(([k, v]) => (
          <div class="flex justify-between"><span>{k}</span><span class="tabular-nums">{v}</span></div>
        ))}
        <div class="mt-3 space-y-0.5 border-t border-slate-200 pt-2 pl-6">
          {cuentaTotales.map(([k, v]) => (
            <div class="flex justify-between"><span class="font-semibold">{k}</span><span class="tabular-nums">{v}</span></div>
          ))}
          <div class="flex justify-between border-t border-slate-300 pt-0.5 font-bold text-primary">
            <span>TOTAL A PAGAR</span><span class="tabular-nums">$ 3.000</span>
          </div>
        </div>
      </div>
    </a>

    <div class="flex flex-col gap-2">
      <a href="#detalle-suministro" data-part="detalle-suministro" class={link} aria-label="Ver explicación: Detalle del Suministro">
        <span class={badge}>3</span>
        <p class={cap}>Detalle del Suministro</p>
        <div class={`${kv} p-2`}>
          {suministro.map(([k, v]) => (<><span class="text-slate-500">{k}</span><span class="font-semibold">: {v}</span></>))}
        </div>
      </a>
      <a href="#detalle-consumo" data-part="detalle-consumo" class={link} aria-label="Ver explicación: Detalle del Consumo">
        <span class={badge}>4</span>
        <p class={cap}>Detalle del Consumo : Mayo</p>
        <div class={`${kv} p-2`}>
          {consumo.map(([k, v]) => (<><span class="text-slate-500">{k}</span><span class="font-semibold">: {v}</span></>))}
        </div>
      </a>
    </div>
  </div>

  <!-- Fila: Consumo últimos 13 meses | Totales -->
  <div class="mt-2 grid gap-2 font-mono text-[10px] leading-relaxed sm:grid-cols-[1.7fr_1fr] sm:text-[11px]">
    <a href="#consumo-13" data-part="consumo-13" class={link} aria-label="Ver explicación: Consumo últimos 13 meses">
      <span class={badge}>6</span>
      <p class={cap}>Consumo últimos 13 meses</p>
      <div class="p-2">
        <div class="flex flex-wrap items-end gap-3">
          <div class="min-w-[180px] flex-1">
            <div class="flex h-20 items-end gap-1">
              {chart.map((h) => <span class="flex-1 rounded-t bg-primary/70" style={`height:${(h / 9) * 100}%`}></span>)}
            </div>
            <div class="mt-0.5 flex gap-1 text-[8px] text-slate-400">
              {meses.map((m) => <span class="flex-1 text-center">{m}</span>)}
            </div>
          </div>
          <div class="space-y-0.5 text-[9px]">
            <p>Monto Último Pago: <b>$ 10000</b></p>
            <p>Fecha Último Pago: 15-05-2024</p>
            <p>Fecha próx.lectura: 25-06-2024</p>
          </div>
        </div>
        <div class="mt-2 border-t border-slate-200 pt-1 text-[9px] text-slate-500">
          <div class="grid grid-cols-2 gap-x-6">
            <span>Nombre :</span><span>Fecha :</span>
            <span>R.U.T :</span><span>Firma :</span>
            <span>Recinto :</span>
          </div>
          <p class="mt-1 text-[7px] leading-tight">EL ACUSE DE RECIBO QUE SE DECLARA EN ESTE ACTO, DE ACUERDO A LO DISPUESTO EN LA LETRA b) DEL Art.4°, Y LA LETRA c) DEL Art.5° DE LA LEY 19.983, ACREDITA QUE LA ENTREGA DE MERCADERIAS O SERVICIO(S) PRESTADO(S) HA(N) SIDO RECIBIDO(S).</p>
        </div>
      </div>
    </a>

    <a href="#totales" data-part="totales" class={link} aria-label="Ver explicación: Totales">
      <span class={badge}>7</span>
      <p class={cap}>Totales</p>
      <div class="p-2">
        <div class="flex items-baseline justify-between font-bold">
          <span>TOTAL A PAGAR $</span><span class="text-lg tabular-nums text-primary">3.000</span>
        </div>
        <div class="mt-1 flex justify-between border-t border-slate-200 pt-1">
          <span>FECHA VENCIMIENTO:</span><span class="font-semibold tabular-nums">21-06-2024</span>
        </div>
        <div class="mt-2 flex flex-col items-center">
          <span class="size-14 rounded-sm" style="background-image: conic-gradient(#111 90deg,#fff 90deg 180deg,#111 180deg 270deg,#fff 270deg); background-size: 6px 6px" aria-hidden="true"></span>
          <p class="mt-1 text-center text-[8px] leading-tight text-slate-500">
            Timbre Electrónico SII<br />Res. 80 del 2014 Verifique documento: <span class="text-blue-600">www.sii.cl</span>
          </p>
        </div>
      </div>
    </a>
  </div>

  <!-- Mensaje (ancho completo) -->
  <a href="#mensaje" data-part="mensaje" class={`${link} mt-2 font-mono text-[10px] leading-relaxed sm:text-[11px]`} aria-label="Ver explicación: Mensaje">
    <span class={badge}>8</span>
    <p class={cap}>Mensaje</p>
    <div class="p-2">
      <p>FONO EMERGENCIAS 9-92261976</p>
      <p>FONO OFICINA 938646480</p>
      <p>FONO WHATSAPP +56950804830</p>
      <p>HORARIO DE ATENCIÓN LUNES A JUEVES MAÑANA DE 8.00 A 13.00 HRS TARDE 14:00 A 17:30 HRS</p>
      <p>HORARIO DE ATENCION VIERNES MAÑANA DE 08:00 A 13:00 HRS TARDE 14:00 A 16:30 HRS</p>
    </div>
  </a>

  <p class="mt-2 text-center text-[9px] text-slate-400">
    Solución de Factura Electrónica de: <span class="text-blue-600">www.acepta.com</span> y <span class="text-blue-600">www.asesora.cl</span>
  </p>
</div>
