---
/** Vista previa de galería en la home (6 imágenes) con enlace a la página completa. */
import { Image } from "astro:assets";
import { Button } from "@/components/ui";
import { images } from "@/assets/images";

const preview = images.galeria.slice(0, 6);
---
<section id="galeria" class="py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="mx-auto mb-12 max-w-2xl text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-primary">Galería</p>
      <h2 class="mt-3 font-display text-4xl font-extrabold sm:text-5xl">
        Nuestro trabajo en imágenes
      </h2>
      <p class="mt-3 text-sm text-muted-foreground">Imágenes de muestra — se reemplazarán por fotos reales del servicio.</p>
    </div>

    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
      {
        preview.map((img, i) => (
          <figure class="group overflow-hidden rounded-[1.5rem] shadow-card">
            <Image
              src={img}
              alt={`Imagen ${i + 1} de la galería del Servicio Sanitario Rural Larmahue`}
              widths={[300, 600]}
              sizes="(min-width: 640px) 33vw, 50vw"
              loading="lazy"
              class="aspect-[4/3] size-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
          </figure>
        ))
      }
    </div>

    <div class="mt-10 flex justify-center">
      <Button href="/galeria" variant="outline">Ver galería completa</Button>
    </div>
  </div>
</section>
