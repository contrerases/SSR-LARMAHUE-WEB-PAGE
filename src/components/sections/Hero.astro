---
/** Hero a sangre: degradado de agua, titular asimétrico + tarjeta glass de
 *  accesos, burbujas y onda inferior que fluye a la sección siguiente. */
import { Button, GlassCard, Bubbles, Badge } from "@/components/ui";
import { content } from "@/data";
import { formatChileanPhone } from "@/lib";

const { site, copy } = content;
---
<section
  id="inicio"
  class="relative isolate overflow-hidden pt-24 text-white sm:pt-28"
  style="background-image: var(--hero-gradient)"
>
  <Bubbles />

  <div class="relative z-10 mx-auto grid max-w-6xl gap-10 px-5 pb-40 pt-10 sm:px-8 lg:grid-cols-12 lg:pb-52">
    <div class="flex flex-col gap-6 lg:col-span-7">
      <Badge tone="onGradient" class="w-fit uppercase tracking-[0.16em]">{copy.hero.eyebrow}</Badge>
      <h1 class="text-balance font-display text-5xl font-extrabold leading-[0.98] sm:text-6xl lg:text-7xl">
        {copy.hero.titleLines.map((line, i) => (
          <>{i > 0 && <br />}{line}</>
        ))}
      </h1>
      <p class="max-w-md text-lg text-white/85">{site.mission}</p>
    </div>

    <div class="lg:col-span-5 lg:mt-8">
      <GlassCard variant="onGradient" radius="xl" class="p-6">
        <p class="mb-4 text-sm font-semibold uppercase tracking-wide text-white/90">Accesos</p>
        <div class="flex flex-col gap-3">
          <Button href={site.services.oficinaVirtual} variant="ov" size="lg" fullWidth>
            Oficina Virtual
          </Button>
          <Button href={site.services.pagoEnLinea} variant="pago" size="lg" fullWidth>
            Pagar mi Boleta
          </Button>
        </div>
        <div class="mt-5 flex items-center justify-between gap-3 rounded-full border border-red-400/50 bg-red-500/20 px-4 py-3 text-sm">
          <span class="flex items-center gap-2 font-semibold text-white">
            <span class="relative flex size-2.5" aria-hidden="true">
              <span class="absolute inline-flex size-full animate-ping rounded-full bg-red-400 opacity-75"></span>
              <span class="relative inline-flex size-2.5 rounded-full bg-red-400"></span>
            </span>
            Emergencias
          </span>
          <span class="font-bold text-white">{formatChileanPhone(site.contact.emergencyPhone)}</span>
        </div>
      </GlassCard>
    </div>
  </div>

  <div class="absolute inset-x-0 bottom-0 z-10 leading-[0]" aria-hidden="true">
    <svg viewBox="0 0 1440 140" preserveAspectRatio="none" class="h-[70px] w-full sm:h-[120px]" style="color: var(--background)">
      <path fill="currentColor" opacity="0.5" d="M0 60 C240 120 480 20 720 60 C960 100 1200 30 1440 70 L1440 140 L0 140 Z"></path>
      <path fill="currentColor" d="M0 90 C240 140 480 50 720 90 C960 120 1200 60 1440 100 L1440 140 L0 140 Z"></path>
    </svg>
  </div>
</section>
