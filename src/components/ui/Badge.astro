---
/** Etiqueta compacta (estado o categoría). */
interface Props {
  tone?: "primary" | "muted" | "ov" | "pago" | "outline";
  class?: string;
}
const { tone = "primary", class: className = "" } = Astro.props;
const tones = {
  primary: "bg-secondary text-secondary-foreground",
  muted: "bg-muted text-muted-foreground",
  ov: "bg-action-ov/12 text-action-ov",
  pago: "bg-action-pago/12 text-action-pago",
  outline: "border border-border text-foreground",
};
---
<span
  class:list={[
    "inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold",
    tones[tone],
    className,
  ]}
>
  <slot />
</span>
