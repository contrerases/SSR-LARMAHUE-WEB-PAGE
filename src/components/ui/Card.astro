---
/**
 * Tarjeta de servicio/acceso (Galería, Videos, Boleta, ...).
 * Superficie temática: en el diseño "Agua" el token --card es translúcido y el
 * backdrop-blur produce el efecto glass automáticamente.
 */
interface Props {
  title: string;
  description?: string;
  href?: string;
  cta?: string;
  external?: boolean;
  class?: string;
}
const {
  title,
  description,
  href,
  cta = "Ver más",
  external = false,
  class: className = "",
} = Astro.props;
const rel = external ? "noopener noreferrer" : undefined;
const target = external ? "_blank" : undefined;
---
<article
  class:list={[
    "group relative flex flex-col rounded-[var(--radius)] border border-border bg-card p-6 text-card-foreground shadow-card backdrop-blur-sm transition-[transform,box-shadow] duration-300 hover:-translate-y-1",
    className,
  ]}
>
  <div class="mb-4 flex size-12 items-center justify-center rounded-[var(--radius-md)] bg-primary/10 text-primary">
    <slot name="icon">
      <svg viewBox="0 0 24 24" fill="none" class="size-6" aria-hidden="true">
        <path
          d="M12 3s6 6.5 6 10a6 6 0 1 1-12 0c0-3.5 6-10 6-10Z"
          fill="currentColor"
          opacity="0.9"></path>
      </svg>
    </slot>
  </div>

  <h3 class="font-display text-lg font-semibold text-foreground">{title}</h3>
  {description && <p class="mt-2 text-sm text-muted-foreground">{description}</p>}

  {
    href && (
      <a
        href={href}
        rel={rel}
        target={target}
        class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-primary after:absolute after:inset-0 after:content-[''] focus-visible:outline-none"
      >
        <span>{cta}</span>
        <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
      </a>
    )
  }
</article>
