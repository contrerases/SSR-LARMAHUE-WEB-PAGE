---
/** Pie de página institucional con datos de contacto. */
import Container from "./Container.astro";
import ContactItem from "./ContactItem.astro";
import { site } from "../../config/site";
const year = 2026;
---
<footer class="border-t border-border bg-muted text-foreground">
  <Container class="grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-1">
      <p class="font-display text-lg font-bold">{site.name}</p>
      <p class="mt-2 max-w-xs text-sm text-muted-foreground">{site.slogan}</p>
    </div>

    <div class="lg:col-span-2">
      <p class="mb-4 text-xs font-semibold uppercase tracking-wide text-muted-foreground">Contacto</p>
      <div class="grid gap-4 sm:grid-cols-2">
        <ContactItem icon="pin" label="Dirección" value={site.location} />
        <ContactItem
          icon="mail"
          label="Correo"
          value={site.contact.email}
          href={`mailto:${site.contact.email}`}
        />
        <ContactItem
          icon="phone"
          label="Fono oficina"
          value={site.contact.officePhone}
          href={`tel:${site.contact.officePhone}`}
        />
        <ContactItem
          icon="emergency"
          label="Emergencias"
          value={site.contact.emergencyPhone}
          href={`tel:${site.contact.emergencyPhone.replace(/\s/g, "")}`}
        />
      </div>
    </div>

    <div class="flex flex-col gap-2 lg:items-end">
      <a href="#" class="text-sm text-muted-foreground transition-colors hover:text-primary">
        Políticas de Privacidad
      </a>
    </div>
  </Container>

  <div class="border-t border-border">
    <Container class="flex flex-col items-center justify-between gap-2 py-5 text-xs text-muted-foreground sm:flex-row">
      <span>© {year} {site.fullName}. Todos los derechos reservados.</span>
      <span>Servicio Sanitario Rural · Pichidegua, Chile</span>
    </Container>
  </div>
</footer>
