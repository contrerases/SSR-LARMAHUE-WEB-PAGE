---
/** Línea de contacto con icono (teléfono, correo, dirección). */
import { cn } from "@/lib";
import { Icon, type IconName } from "./Icon";

interface Props {
  icon: IconName;
  label: string;
  value: string;
  href?: string;
  class?: string;
}
const { icon, label, value, href, class: className } = Astro.props;
const Tag = href ? "a" : "div";
---
<Tag
  href={href}
  class={cn("flex items-start gap-3", href && "transition-colors hover:text-primary", className)}
>
  <span class="mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-[var(--radius-md)] bg-primary/10 text-primary">
    <Icon name={icon} size="1.15rem" />
  </span>
  <span class="flex flex-col">
    <span class="text-xs font-medium uppercase tracking-wide text-muted-foreground">{label}</span>
    <span class="font-medium text-foreground">{value}</span>
  </span>
</Tag>
