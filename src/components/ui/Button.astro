---
/**
 * Botón / enlace con variantes semánticas.
 * Variantes de acción `ov` y `pago` = patrón reconocible del sitio
 * (Oficina Virtual en teal, Pago en Línea en verde).
 */
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "outline" | "ghost" | "ov" | "pago";
  size?: "sm" | "md" | "lg";
  external?: boolean;
  type?: "button" | "submit" | "reset";
  class?: string;
}
const {
  href,
  variant = "primary",
  size = "md",
  external = false,
  type = "button",
  class: className = "",
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 font-medium leading-none rounded-[var(--radius-button)] transition-[background-color,box-shadow,transform,opacity] duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring active:translate-y-px disabled:opacity-50 disabled:pointer-events-none";

const sizes = {
  sm: "h-9 px-4 text-sm",
  md: "h-11 px-5 text-[0.95rem]",
  lg: "h-12 px-7 text-base",
};

const variants = {
  primary: "bg-primary text-primary-foreground shadow-sm hover:opacity-90",
  secondary: "bg-secondary text-secondary-foreground hover:brightness-95",
  outline:
    "border border-border bg-transparent text-foreground hover:bg-muted",
  ghost: "bg-transparent text-foreground hover:bg-muted",
  ov: "bg-action-ov text-action-ov-foreground shadow-sm hover:opacity-90",
  pago: "bg-action-pago text-action-pago-foreground shadow-sm hover:opacity-90",
};

const cls = [base, sizes[size], variants[variant], className];
const rel = external ? "noopener noreferrer" : undefined;
const target = external ? "_blank" : undefined;
---
{
  href ? (
    <a href={href} class:list={cls} rel={rel} target={target}>
      <slot />
    </a>
  ) : (
    <button type={type} class:list={cls}>
      <slot />
    </button>
  )
}
