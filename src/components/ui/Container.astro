---
/** Contenedor centrado con ancho máximo y padding lateral responsivo. */
interface Props {
  as?: string;
  size?: "sm" | "md" | "lg";
  class?: string;
}
const { as: Tag = "div", size = "lg", class: className = "" } = Astro.props;
const widths = {
  sm: "max-w-3xl",
  md: "max-w-5xl",
  lg: "max-w-6xl",
};
---
<Tag class:list={["mx-auto w-full px-5 sm:px-8", widths[size], className]}>
  <slot />
</Tag>
